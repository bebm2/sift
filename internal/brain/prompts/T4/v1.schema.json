{
  "$id": "https://sift.dev/decode/t4_output.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "conclusion": {
      "type": "string",
      "x-sift:maxBytes": 1000
    },
    "headline": {
      "type": "string",
      "x-sift:maxBytes": 160
    },
    "key_points": {
      "items": {
        "type": "string",
        "x-sift:maxBytes": 1000,
        "x-sift:minBytes": 1
      },
      "maxItems": 3,
      "minItems": 1,
      "type": "array"
    },
    "options": {
      "items": {
        "type": "string",
        "x-sift:maxBytes": 64,
        "x-sift:minBytes": 1
